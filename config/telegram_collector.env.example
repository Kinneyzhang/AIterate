# AIIterate Telegram collector configuration.
# Copy to config/telegram_collector.env and fill real values.
# The real file is gitignored.

TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=CHANGE_ME
TELEGRAM_SESSION=/home/YOUR_USER/vibe/aiterate/data/tg_session_summary
# Optional. Example:
# TELEGRAM_PROXY=socks5://user:password@127.0.0.1:7890

AITERATE_BASE_URL=http://127.0.0.1:7070
# Optional. If omitted, collector reads admin_token from AIIterate DB settings.
# AITERATE_ADMIN_TOKEN=

AITERATE_COLLECTOR_STATE_DIR=/home/YOUR_USER/vibe/aiterate/data/telegram_collector_state
